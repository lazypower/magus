variant: fcos
version: "1.6.0"

# Day-2 Butane consumed by magus apply (not Ignition).
# Configures continuous reconcilers for things magus owns post-boot.

systemd:
  units:
    - name: magus-dns-heartbeat.timer
      enabled: true
      contents: |
        [Unit]
        Description=DNS heartbeat every 2 minutes

        [Timer]
        OnBootSec=15
        OnUnitActiveSec=2min
        RandomizedDelaySec=30

        [Install]
        WantedBy=timers.target

    - name: magus-dns-heartbeat.service
      contents: |
        [Unit]
        Description=DNS heartbeat registration via labdns
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        ExecStart=/usr/bin/bash -c 'set -euo pipefail; \
          echo "[magus] sending dns heartbeat..." >&2; \
          curl -sf -X POST http://bastion.wabash.place:8053/api/v1/heartbeat \
            -H "Content-Type: application/json" \
            -d "{\"hostname\": \"%H\", \"zone\": \"wabash.place\", \"ttl\": 300}"; \
          echo "[magus] dns heartbeat sent" >&2'
